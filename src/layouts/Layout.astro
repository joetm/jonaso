---
// The one global stylesheet (see the comment in it). Page-only Semantic UI
// modules stay imported in the pages/views that use them.
import '../styles/global.css'

import Bare from './Bare.astro'
import Nav from '../components/Nav.astro'

const { title = 'jonaso.de', description = '', canonical, style = '' } = Astro.props
---

<Bare title={title} description={description} canonical={canonical}>
  <slot name="head" slot="head" />
  <div class="site-wrapper" style={style}>
    <Nav currentPath={Astro.url.pathname} />
    <slot />
  </div>
  {/* full-width content below the constrained wrapper (art galleries) */}
  <slot name="wide" />
</Bare>
