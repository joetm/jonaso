---
import Layout from '../layouts/Layout.astro'
import Home from '../views/index.jsx'
---

<Layout title="Jonas Oppenlaender">
  <Fragment slot="head">
    <link rel="preload" href="/img/research-areas-bubbles-creative-genAI.jpg" as="image" type="image/jpeg" />
  </Fragment>
  <Home />
</Layout>

<script>
  // pronunciation audio for the button in views/index.jsx (vanilla, no island):
  // shows the "volume up" icon while playing
  const btn = document.getElementById('pronounce')
  if (btn) {
    const [listen, playing] = btn.querySelectorAll('svg')
    const audio = new Audio('/audio/speech_20230621150721178.mp3')
    const setPlaying = (on: boolean) => {
      listen.toggleAttribute('hidden', on)
      playing.toggleAttribute('hidden', !on)
      btn.style.color = on ? 'var(--muted, #666666)' : ''
    }
    audio.addEventListener('play', () => setPlaying(true))
    audio.addEventListener('ended', () => setPlaying(false))
    btn.addEventListener('click', () => audio.play())
  }
</script>
