---
import 'semantic-ui-css/components/button.min.css'

import Layout from '../../layouts/Layout.astro'
import LTInterests from '../../components/islands/LTInterests.jsx'
import Keywords, { CUTOFF } from '../../components/islands/Keywords.jsx'

import timeline from '../../../reading_list/topkeyword-timeline.json'
import keywordsRaw from '../../../reading_list/keywords.json'

// start date filtering (2017-01-01); was done after a client-side fetch
const graphdata = { ...timeline, data: timeline.data.filter((o) => o.t > 1483221600) }
// level-1 keywords, prefiltered at build time
const keywords = keywordsRaw.filter((kw) => kw.num > CUTOFF)
---

<Layout title="Research Interests // jonaso.de" canonical="https://www.jonaso.de/interests/">
  <div class="ui container">
    <div class="ui segment" style="clear: both; border: 0; box-shadow: 0px 0px 0px #ffffff;">
      <h2 style="float: left; display: inline-block; margin-right: 1rem;">Research Interests</h2>

      <p style="height: 5em; text-align: right;">
        &rarr; View my <a href="/research/ontology/">research ontology</a>.
      </p>
    </div>
    <LTInterests client:visible graphdata={graphdata} />
    <Keywords client:visible initial={keywords} />
  </div>
</Layout>
